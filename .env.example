# Django development
HOST=http://localhost:8000

# Local PostgreSQL/PostGIS
DATABASE_NAME=maps_local
DATABASE_USER=maps_local
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5433

# Homebrew paths on Apple Silicon macOS
GDAL_LIBRARY_PATH=/opt/homebrew/opt/gdal/lib/libgdal.dylib
GEOS_LIBRARY_PATH=/opt/homebrew/opt/geos/lib/libgeos_c.dylib

# Required during startup by the current Cognito integration
COGNITO_REGION=ca-central-1
COGNITO_USERPOOL_ID=your-user-pool-id
COGNITO_APP_CLIENT_ID=your-app-client-id
